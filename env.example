# ============================================================
# RAG 系统配置（.env）
# 复制本文件为 .env 并填写，config.py 会自动加载。
# 未填写的项使用 config.py 中的默认值。
# ============================================================

# ===== Embedding 模型 =====
# 本地开源中文 embedding 模型
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"

# ===== 向量库（Chroma）=====
# 类型：chroma（默认）/ pgvector / milvus
VECTOR_STORE_TYPE="chroma"
# 持久化目录（默认 rag/chroma_db）
#CHROMA_DIR=""
# 集合名
COLLECTION_NAME="business_docs"
# pgvector 连接（切换到 pgvector 时启用）
#PGVECTOR_URL="postgresql+psycopg://postgres:postgres@localhost:5432/rag"
# Milvus 连接（切换到 milvus 时启用）
#MILVUS_HOST="localhost"
#MILVUS_PORT=19530

# ===== 检索参数 =====
TOP_K=5                # 召回数量
SCORE_THRESHOLD=0.4    # 相似度阈值（上下文污染过滤）

# ===== 数据库连接 =====
DB_URL="mysql+pymysql://root:root@localhost:3306/VIP_USER"

# ===== LLM 配置（DeepSeek）=====
# 注意：生产环境请勿在代码中硬编码密钥，统一在此处配置
OPENAI_API_KEY="sk-REDACTED_DEEPSEEK"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-v4-flash"

# ===== 本地文件知识库目录 =====
# 放入需要入库的文档（txt/md/pdf 等）
#KNOWLEDGE_DIR=""

# ===== Redis 缓存（查询缓存）=====
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=3600          # 缓存过期时间（秒），默认 1 小时

# ===== Langfuse 可观测性（可选）=====
# 在 https://cloud.langfuse.com 注册并创建项目后填入以下 key。
# 未配置时 trace 自动禁用，不影响正常功能。
LANGFUSE_PUBLIC_KEY="pk-REDACTED_LANGFUSE"
LANGFUSE_SECRET_KEY="sk-REDACTED_LANGFUSE"
LANGFUSE_HOST="https://cloud.langfuse.com"
